# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Build output
.next/
# Directories a stale build was moved aside into, rather than deleted.
.next-stale*/
_to_delete/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Secrets. There is nothing here that reads a key — the environment takes no
# configuration at all, which is why there is no .env.example to un-ignore —
# but a dotenv that wanders in from a sibling checkout must not be committed.
.env
.env.*
*.pem
*.key

# Deployment
.vercel
.netlify

# Test and coverage
coverage/
.nyc_output/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

